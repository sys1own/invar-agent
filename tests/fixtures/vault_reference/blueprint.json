  "code_template": "import math\n\ndef mm_rate(s, vmax, km):\n    denom = km + s\n    if denom <= 0.0:\n        return 0.0\n    return vmax * s / denom\n\ndef simulation_step(buf, dt):\n    s = buf.data[0]\n    p = buf.data[1]\n    vmax = buf.data[2]\n    km = buf.data[3]\n    kc = buf.data[4]\n    if buf.data[5] == 0.0:\n        buf.data[5] = s\n        buf.data[6] = p\n        buf.data[9] = s + p\n    r1 = mm_rate(s, vmax, km)\n    k1s = -r1\n    k1p = r1 - kc * p\n    s2 = s + 0.5 * dt * k1s\n    p2 = p + 0.5 * dt * k1p\n    if s2 < 0.0:\n        s2 = 0.0\n    if p2 < 0.0:\n        p2 = 0.0\n    r2 = mm_rate(s2, vmax, km)\n    k2s = -r2\n    k2p = r2 - kc * p2\n    s3 = s + 0.5 * dt * k2s\n    p3 = p + 0.5 * dt * k2p\n    if s3 < 0.0:\n        s3 = 0.0\n    if p3 < 0.0:\n        p3 = 0.0\n    r3 = mm_rate(s3, vmax, km)\n    k3s = -r3\n    k3p = r3 - kc * p3\n    s4 = s + dt * k3s\n    p4 = p + dt * k3p\n    if s4 < 0.0:\n        s4 = 0.0\n    if p4 < 0.0:\n        p4 = 0.0\n    r4 = mm_rate(s4, vmax, km)\n    k4s = -r4\n    k4p = r4 - kc * p4\n    s_new = s + (dt / 6.0) * (k1s + 2.0 * k2s + 2.0 * k3s + k4s)\n    p_new = p + (dt / 6.0) * (k1p + 2.0 * k2p + 2.0 * k3p + k4p)\n    if s_new < 0.0:\n        s_new = 0.0\n    if p_new < 0.0:\n        p_new = 0.0\n    conv = (s - s_new) - ((p_new - p) + dt * kc * p)\n    buf.data[0] = s_new\n    buf.data[1] = p_new\n    buf.data[7] = buf.data[7] + conv * conv\n    if p_new > buf.data[8]:\n        buf.data[8] = p_new\n",
